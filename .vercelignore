.git
.gitignore
build.py
LICENSE.md
package.json
package-lock.json
.env.local
.vercel

# Only the Material Icons font is used at runtime — ignore every other icon set.
third_party/material-design-icons/*
!third_party/material-design-icons/iconfont/
third_party/jquery/jquery-1.8.3.js
third_party/jquery/LICENSE
third_party/codemirror.next/bundle.ts
third_party/codemirror.next/package.json
third_party/codemirror.next/package-lock.json
third_party/codemirror.next/rollup.config.js
README.md
_locales

# App scripts are concatenated+minified into js/app.<hash>.min.js (see
# scripts/build.mjs); only the bundle needs to be deployed.
js/*.js
!js/app.*.min.js
